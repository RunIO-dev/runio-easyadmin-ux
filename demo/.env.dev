# Committed defaults for the demo app in the dev environment only.
# Your own APP_SECRET belongs in .env.dev.local, which git ignores.
APP_SECRET=demo-only-not-a-secret-override-in-env-dev-local

# Matches the throwaway MariaDB container in ../demo-compose.yaml.
DATABASE_URL="mysql://meaga:meaga_dev@127.0.0.1:3317/meaga_demo?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
